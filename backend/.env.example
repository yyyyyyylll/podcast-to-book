# podcast-to-book — 后端环境变量

# ── LLM（必填）─────────────────────────────────────────────────────
# 兼容 OpenAI 协议的服务，DeepSeek / OpenAI / Anthropic 兼容层 / GeekAI 等都可以
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-reasoner
LLM_MAX_TOKENS=65536

# Google Gemini（可选，部分工作流节点会用作 fallback）
GOOGLE_API_KEY=

# 阿里 DashScope（可选，备用 LLM）
DASHSCOPE_API_KEY=

# ── ASR：腾讯云语音识别（必填）─────────────────────────────────────
# 1. 控制台开通"语音识别"服务: https://console.cloud.tencent.com/asr
# 2. 创建子账号 + 颁发 SecretId/SecretKey: https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# ── COS 对象存储（必填：ASR 大文件中转）────────────────────────────
# 腾讯云 ASR 直传只支持 5MB 以内音频，大文件需要先传到 COS。
# 创建 COS 桶: https://console.cloud.tencent.com/cos/bucket
COS_BUCKET=               # 例如 asr-1234567890
COS_REGION=               # 例如 ap-shanghai
COS_PREFIX=asr-audio      # 桶内子路径前缀

# ── 应用基础 ───────────────────────────────────────────────────────
APP_NAME=podcast-to-book
STORAGE_DIR=./storage
DATABASE_URL=sqlite+aiosqlite:///./storage/app.db
FRONTEND_DIR=

# ── 可选：YouTube 输入（需要本地装 yt-dlp）─────────────────────────
ENABLE_YOUTUBE_INPUT=false

# ── 可选：搜索增强（Serper API，用于一些 LLM 知识获取节点）─────────
# SERPER_API_KEY=
